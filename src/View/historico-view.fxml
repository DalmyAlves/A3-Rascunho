<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.HistoricoController">
   <top>
      <HBox alignment="CENTER" style="-fx-background-color: #2c2f33; -fx-padding: 10;">
         <Label text="Estatísticas do Campeonato" textFill="WHITE">
            <font>
               <Font name="System Bold" size="18.0" />
            </font>
         </Label>
      </HBox>
   </top>
   <left>
      <VBox alignment="TOP_CENTER" prefWidth="200.0" style="-fx-background-color: #23272a; -fx-padding: 20;" spacing="20">
         <Label text="USUÁRIO:" textFill="#99aab5">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>
         <Label text="JOGADOR" textFill="#ffffff">
            <font>
               <Font name="System Bold" size="16.0" />
            </font>
         </Label>
         <Region VBox.vgrow="ALWAYS" />
         <Button mnemonicParsing="false" prefWidth="150.0" text="Início" />
         <Button mnemonicParsing="false" prefWidth="150.0" text="Criar Torneio" />
         <Button mnemonicParsing="false" prefWidth="150.0" text="Espectar Torneio" />
      </VBox>
   </left>
   <center>
      <VBox style="-fx-background-color: #36393f; -fx-padding: 20;" spacing="15" BorderPane.alignment="CENTER">
         <Label text="E - GAME LEAGUE: HISTÓRICO" textFill="#ffffff">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Label>

         <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Filtrar por Jogo:" textFill="#c0c0c0"/>
            <ComboBox fx:id="cbJogoHistorico" promptText="Selecione um Jogo"/> <Button text="Aplicar Filtro" onAction="#aplicarFiltroHistorico"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUltimaAtualizacaoHistorico" text="Última atualização: --/--/---- --:--:--" textFill="#c0c0c0"/>
         </HBox>

         <TableView fx:id="tabelaHistorico" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colDataHora" text="Data/Hora" prefWidth="120"/>
               <TableColumn fx:id="colTipoEvento" text="Tipo" prefWidth="80"/>
               <TableColumn fx:id="colJogo" text="Jogo" prefWidth="120"/> <TableColumn fx:id="colPontos" text="Pontos" prefWidth="80"/> <TableColumn fx:id="colJogadores" text="Jogadores Envolvidos" prefWidth="250"/> <TableColumn fx:id="colPosicao" text="Posição" prefWidth="80"/> </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
         </TableView>
      </VBox>
   </center>
</BorderPane>