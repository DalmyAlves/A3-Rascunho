<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.HelloController">

    <left>
        <VBox alignment="TOP_CENTER" prefHeight="558.0" prefWidth="228.0" spacing="10" BorderPane.alignment="CENTER">
            <children>
            <Pane prefHeight="566.0" prefWidth="228.0">
               <children>
                      <Label layoutX="82.0" layoutY="60.0" text="Filtrar por:">
                          <font>
                              <Font name="Arial" size="14.0" />
                          </font>
                      </Label>
                      <ComboBox fx:id="cbTorneio" layoutX="25.0" layoutY="102.0" prefHeight="25.0" prefWidth="177.0" promptText="Selecionar o Torneio" />
                      <DatePicker layoutX="25.0" layoutY="151.0" prefHeight="25.0" prefWidth="177.0" />
                      <Button fx:id="btnAplicar" layoutX="86.0" layoutY="200.0" onAction="#aplicarFiltro" text="Aplicar" />
               </children>
            </Pane>
            </children>
        </VBox>
    </left>

    <center>
        <TableView fx:id="tabela" prefHeight="558.0" prefWidth="536.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colNome" prefWidth="181.0" text="Time/Jogador" />
                <TableColumn fx:id="colJogos" prefWidth="84.0" text="Jogos" />
                <TableColumn fx:id="colVitorias" prefWidth="83.0" text="Vitórias" />
                <TableColumn fx:id="colDerrotas" prefWidth="108.0" text="Derrotas" />
                <TableColumn fx:id="colPontos" prefWidth="108.0" text="Pontos" />
                <TableColumn fx:id="colRanking" prefWidth="84.0" text="Ranking" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="34.0" prefWidth="871.0" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="lblUltimaAtualizacao" alignment="BOTTOM_CENTER" prefHeight="16.0" prefWidth="300.0" text="Última atualização:">
                    <font>
                        <Font name="Arial" size="14.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </bottom>
   <top>
      <Label text="Estatísticas do Campeonato" BorderPane.alignment="CENTER">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
   </top>
</BorderPane>
